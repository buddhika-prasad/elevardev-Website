"use client";

import { useRef, useEffect } from "react";
import { gsap, ScrollTrigger } from "@/lib/gsap";
import { useReducedMotion } from "@/hooks/useReducedMotion";

const services = [
  {
    number: "01",
    title: "Custom Software Development",
    description:
      "Tailored solutions built from the ground up to meet your unique business requirements and scale with your growth.",
  },
  {
    number: "02",
    title: "Web Application Development",
    description:
      "Modern, responsive web applications with cutting-edge technologies, optimized for performance and user experience.",
  },
  {
    number: "03",
    title: "Mobile App Development",
    description:
      "Native and cross-platform mobile applications for Android & iOS, delivering seamless experiences across devices.",
  },
  {
    number: "04",
    title: "SaaS Product Development",
    description:
      "Scalable Software-as-a-Service platforms designed for growth, with robust architecture and cloud infrastructure.",
  },
  {
    number: "05",
    title: "UI/UX Design",
    description:
      "User-centered design that combines aesthetics with functionality, creating intuitive and engaging digital experiences.",
  },
  {
    number: "06",
    title: "System Integration & Automation",
    description:
      "Seamless integration of existing systems and automation of workflows to improve efficiency and reduce manual work.",
  },
];

export function Services() {
  const sectionRef = useRef<HTMLElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const headingRef = useRef<HTMLDivElement>(null);
  const horizontalRef = useRef<HTMLDivElement>(null);
  const prefersReducedMotion = useReducedMotion();

  useEffect(() => {
    if (prefersReducedMotion) return;

    const ctx = gsap.context(() => {
      // Heading animation
      if (headingRef.current) {
        gsap.fromTo(
          headingRef.current,
          { y: 50, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 1,
            ease: "power3.out",
            scrollTrigger: {
              trigger: headingRef.current,
              start: "top 85%",
              toggleActions: "play none none none",
            },
          }
        );
      }

      // Horizontal scroll animation
      if (horizontalRef.current && containerRef.current) {
        const calculateTotalWidth = () => {
          return horizontalRef.current!.scrollWidth - containerRef.current!.offsetWidth;
        };

        gsap.to(horizontalRef.current, {
          x: () => -calculateTotalWidth(),
          ease: "none",
          scrollTrigger: {
            trigger: containerRef.current,
            start: "top top",
            end: () => `+=${calculateTotalWidth()}`,
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
      }
    }, sectionRef);

    return () => ctx.revert();
  }, [prefersReducedMotion]);

  return (
    <section
      ref={sectionRef}
      id="services"
      className="relative overflow-hidden"
      style={{ backgroundColor: "var(--bg-primary)" }}
      aria-labelledby="services-heading"
    >
      <div ref={containerRef} className="relative">
        {/* Heading */}
        <div ref={headingRef} className="px-4 px-5 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-12 sm:pb-16 md:pt-40 md:pb-20">
          <div className="max-w-7xl mx-auto">
            <h2
              id="services-heading"
              className="text-4xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-[var(--text-primary)] mb-4 sm:mb-6"
            >
              Our <span className="gradient-text">Services</span>
            </h2>
            <p className="text-lg sm:text-xl md:text-2xl text-[var(--text-secondary)] max-w-3xl leading-[1.7] tracking-tight font-light">
              Comprehensive software solutions tailored to elevate your business
            </p>
          </div>
        </div>

        {/* Horizontal Scroll Container */}
        <div className="relative overflow-hidden" style={{ backgroundColor: "var(--bg-primary)" }}>
          <div
            ref={horizontalRef}
            className="flex will-change-transform"
            style={{ width: "max-content" }}
          >
            {services.map((service, index) => (
              <div
                key={service.number}
                className="flex-shrink-0 w-screen px-4 px-5 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-32"
                style={{ minWidth: "100vw" }}
              >
                <div className="max-w-7xl mx-auto flex items-center min-h-[50vh] sm:min-h-[60vh]">
                  <div className="max-w-4xl w-full">
                    {/* Large number */}
                    <div className="mb-6 sm:mb-8 md:mb-12">
                      <span className="text-6xl text-7xl sm:text-8xl md:text-9xl lg:text-[12rem] font-bold text-[var(--text-primary)] opacity-10 dark:opacity-5 leading-none tracking-tight">
                        {service.number}
                      </span>
                    </div>

                    {/* Title */}
                    <h3 className="text-3xl text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-4 sm:mb-6 md:mb-8 text-[var(--text-primary)] tracking-tight leading-[1.1]">
                      {service.title}
                    </h3>

                    {/* Description */}
                    <p className="text-base sm:text-lg md:text-xl lg:text-2xl text-[var(--text-secondary)] leading-[1.7] sm:leading-[1.8] tracking-tight font-light max-w-3xl">
                      {service.description}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Scroll hint */}
        <div className="px-5 sm:px-6 lg:px-8 pb-16 md:pb-20">
          <div className="max-w-7xl mx-auto text-center">
            <p className="text-sm text-[var(--text-secondary)] tracking-tight">
              Scroll horizontally →
            </p>
          </div>
        </div>
      </div>
    </section>
  );
}
